{
  "name": "proofline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first research chat with one web_search tool, SQLite recall, quote-validated evidence and code-assigned comparisons.",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "demo": "node scripts/demo.mjs",
    "eval:live": "node scripts/live-eval.mjs",
    "eval:live:quick": "node scripts/live-eval.mjs --quick",
    "eval:live:full": "node scripts/live-eval.mjs --full",
    "eval:cold": "node scripts/cold-eval.mjs",
    "dev": "node --watch src/main.mjs",
    "start": "node src/main.mjs",
    "lint": "node scripts/lint.mjs",
    "format": "node scripts/format-check.mjs --write",
    "check": "npm run syntax && npm run lint && npm run format:check && npm run check:wording && npm run docs:check && npm test && npm run test:dates",
    "check:wording": "node scripts/check-wording.mjs",
    "check:hosted": "node scripts/check-hosted.mjs",
    "docs:sync": "node scripts/docs-sync.mjs",
    "transcripts": "node scripts/make-transcripts.mjs",
    "test": "node --import ./tests/test-env.mjs --test tests/*.test.mjs",
    "test:dates": "node scripts/test-dates.mjs",
    "eval": "node evals/run.mjs",
    "import": "node scripts/import.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "format:check": "node scripts/format-check.mjs",
    "syntax": "node scripts/verify.mjs",
    "smoke": "node scripts/smoke.mjs",
    "docs:check": "node scripts/document-check.mjs"
  }
}
