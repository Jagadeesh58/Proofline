# Gemini API key for live model answers.
GEMINI_API_KEY=
# Comma-separated list of Gemini models to try in order on 429, 404 or 5xx.
GEMINI_MODELS=
# Gemini model identifier; the code uses its default when this is blank.
GEMINI_MODEL=
# Gemini fallback model identifier when primary model fails; defaults to gemini-3.5-flash-lite.
GEMINI_FALLBACK_MODEL=
# Soft throttle maximum Gemini requests per minute; defaults to 8.
GEMINI_REQUESTS_PER_MINUTE=
# Gemini thinking level; the code defaults to low.
GEMINI_THINKING_LEVEL=
# Optional Gemini sampling temperature; blank leaves the provider default.
GEMINI_TEMPERATURE=
# Tavily API key for live web search.
TAVILY_API_KEY=
# Search backend: tavily for live search or replay for synthetic offline fixtures.
SEARCH_BACKEND=
# Evaluation-only grader API key; never used by the chat agent.
EVAL_GRADER_API_KEY=
# Evaluation-only grader model identifier.
EVAL_GRADER_MODEL=
# Evaluation-only OpenAI-compatible grader base URL.
EVAL_GRADER_BASE_URL=
# Server bind host; defaults to 127.0.0.1.
HOST=
# Server port; defaults to 3000.
PORT=
# IANA timezone for dates; defaults to Asia/Kolkata.
TIMEZONE=
# SQLite database path; defaults to data/chat-agent.sqlite.
DB_PATH=
# Maximum request body size in bytes; defaults to 100000.
MAX_REQUEST_BYTES=
# Rate-limit window in milliseconds; defaults to 600000.
RATE_LIMIT_WINDOW_MS=
# Maximum requests per IP per rate-limit window; defaults to 30.
RATE_LIMIT_MAX=
# Maximum recent turns passed to model context; defaults to 8.
MAX_CONTEXT_TURNS=
# Maximum characters retained per recent question/answer; defaults to 1500.
MAX_CONTEXT_CHARS=
# Maximum model rounds per turn; capped at 3.
MAX_TOOL_ROUNDS=
# Maximum Tavily searches per turn; capped at 14.
MAX_TAVILY_SEARCHES=
# Maximum Tavily page extracts per turn; capped at 8.
MAX_TAVILY_EXTRACTS=
# Maximum Gemini calls per turn; capped at 10.
MAX_GEMINI_CALLS=
# Extraction mode: per_entity by default; batched is the fallback for low per-minute Gemini limits.
EXTRACTION_MODE=per_entity
# Provider request timeout in milliseconds; defaults to 25000.
REQUEST_TIMEOUT_MS=
# Maximum number of page extracts requested per free-form query; defaults to 1 and is capped at 3.
MAX_EXTRACTS_PER_QUERY=
